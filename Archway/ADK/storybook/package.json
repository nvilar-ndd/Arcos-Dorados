{
  "name": "@adk/storybook",
  "private": true,
  "version": "0.1.0",
  "description": "Storybook de ADK (Advance Kiosk) — Foundations, plantilla de kiosco y docs a partir de tokens/adk.tokens.json (Figma SSOT).",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "fonts": "node scripts/install-fonts.mjs",
    "dev": "npm run tokens && storybook dev -p 6008",
    "build": "npm run tokens && storybook build -o storybook-static",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "lucide-vue-next": "0.475.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/theming": "8.6.14",
    "@storybook/vue3": "8.6.14",
    "@storybook/vue3-vite": "8.6.14",
    "@vitejs/plugin-vue": "5.2.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "storybook": "8.6.14",
    "storybook-addon-pseudo-states": "4.0.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vue-tsc": "2.2.10"
  }
}
